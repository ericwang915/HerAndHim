{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "%model%"
    }
  },
  "2": {
    "class_type": "InstantIDModelLoader",
    "inputs": {
      "instantid_file": "ip-adapter.bin"
    }
  },
  "3": {
    "class_type": "InstantIDFaceAnalysis",
    "inputs": {
      "provider": "CPU"
    }
  },
  "4": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "instantid/diffusion_pytorch_model.safetensors"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "%reference%"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "%prompt%",
      "clip": ["1", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "%negative%",
      "clip": ["1", 1]
    }
  },
  "8": {
    "class_type": "ApplyInstantID",
    "inputs": {
      "instantid": ["2", 0],
      "insightface": ["3", 0],
      "control_net": ["4", 0],
      "image": ["5", 0],
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "weight": 0.8,
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "9": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "%width%",
      "height": "%height%",
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "%seed%",
      "steps": 28,
      "cfg": 5.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["8", 0],
      "positive": ["8", 1],
      "negative": ["8", 2],
      "latent_image": ["9", 0]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["10", 0],
      "vae": ["1", 2]
    }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "HerAndHim",
      "images": ["11", 0]
    }
  }
}
