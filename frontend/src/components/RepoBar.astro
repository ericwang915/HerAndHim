---
import GhIcon from './GhIcon.astro';
const repo = 'https://github.com/ericwang915/HerAndHim';
---
<a class="repobar" href={repo} target="_blank" rel="noopener">
  <span class="repobar__left">
    <GhIcon size={15} class="repobar__gh" />
    <strong>ericwang915/HerAndHim</strong>
    <span class="sep">·</span>
    <span class="desc">open-source AI companion you self-host</span>
  </span>
  <span class="repobar__right">
    <span class="pill">Python</span>
    <span class="pill">AGPL-3.0</span>
    <span class="pill star">★ Star <span data-stars></span></span>
  </span>
</a>

<style>
  .repobar {
    display: flex; align-items: center; justify-content: center; gap: 18px; flex-wrap: wrap;
    padding: 9px 24px; font-size: 0.86rem; color: var(--text-soft);
    background: rgba(255, 255, 255, 0.035);
    border-bottom: 1px solid var(--border);
  }
  .repobar:hover { opacity: 1; color: var(--text); }
  .repobar__left, .repobar__right { display: flex; align-items: center; gap: 10px; }
  .repobar__gh { color: var(--text); }
  .repobar strong { color: var(--text); font-weight: 600; font-family: var(--mono); font-size: 0.82rem; }
  .sep { color: var(--text-muted); }
  .desc { color: var(--text-soft); }
  .pill {
    padding: 2px 10px; font-size: 0.75rem; border-radius: 100px;
    border: 1px solid var(--border-strong); color: var(--text-soft);
  }
  .pill.star { color: var(--accent); border-color: rgba(243,160,182,0.35); }
  @media (max-width: 720px) { .desc, .pill:not(.star) { display: none; } }
</style>
